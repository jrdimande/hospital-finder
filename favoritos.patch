diff --git a/src/composables/useFavorites.js b/src/composables/useFavorites.js
new file mode 100644
index 0000000..1cc13e7
--- /dev/null
+++ b/src/composables/useFavorites.js
@@ -0,0 +1,47 @@
+import { ref, watch } from 'vue'
+
+const STORAGE_KEY = 'saude-mz:favoritos'
+
+function readStoredIds() {
+  if (typeof window === 'undefined') return []
+  try {
+    const raw = window.localStorage.getItem(STORAGE_KEY)
+    const parsed = raw ? JSON.parse(raw) : []
+    return Array.isArray(parsed) ? parsed : []
+  } catch {
+    return []
+  }
+}
+
+const favoriteIds = ref(new Set(readStoredIds()))
+
+watch(
+  favoriteIds,
+  (ids) => {
+    if (typeof window === 'undefined') return
+    try {
+      window.localStorage.setItem(STORAGE_KEY, JSON.stringify([...ids]))
+    } catch {
+      // Armazenamento indisponível (ex.: modo privado); os favoritos deixam de ser persistidos.
+    }
+  },
+  { deep: true },
+)
+
+export function useFavorites() {
+  function isFavorite(id) {
+    return favoriteIds.value.has(id)
+  }
+
+  function toggleFavorite(id) {
+    const next = new Set(favoriteIds.value)
+    if (next.has(id)) {
+      next.delete(id)
+    } else {
+      next.add(id)
+    }
+    favoriteIds.value = next
+  }
+
+  return { favoriteIds, isFavorite, toggleFavorite }
+}
